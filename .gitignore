# Secrets — never commit
.env
.env.local
frontend/.env
frontend/.env.local

# Local dev SQLite databases (created by app/dev_seed.py)
*.db
*.db-journal

# Admin-uploaded images (app/routers/admin_uploads.py) — local disk storage,
# not meant to be committed
app/static/uploads/

# Private order documents (app/services/documents.py)
app/private_documents/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.venv/
venv/

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code local (machine-specific) settings
.claude/settings.local.json
