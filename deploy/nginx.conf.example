# Example nginx site for MARU - one domain for storefront + API.
# NOT TESTED: there is no nginx on the dev machine. Replace shop.example.com,
# certificate paths and /srv/maru, then run `nginx -t` before reloading.
#
# Layout assumed:
#   /srv/maru/frontend/dist   -> output of `npm run build` in frontend/
#   127.0.0.1:8000            -> uvicorn (see maru-backend.service)
#
# Backend .env for this layout:
#   FRONTEND_URL=https://shop.example.com
#   BACKEND_URL=https://shop.example.com        (uploaded-file URLs use it)
#   CORS_ORIGINS=https://shop.example.com
# Frontend build (its default API address is localhost, so this is required):
#   VITE_API_BASE_URL=https://shop.example.com/api/v1 npm run build

server {
    listen 80;
    server_name shop.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name shop.example.com;

    ssl_certificate     /etc/letsencrypt/live/shop.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/shop.example.com/privkey.pem;

    # Admin video uploads are capped at 25 MB by the API; leave headroom.
    client_max_body_size 30m;

    # --- API (adds its own security headers) --------------------------------
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # nginx's own request id becomes the API's X-Request-ID, so one id
        # ties the nginx access log to the application log.
        proxy_set_header X-Request-ID      $request_id;
        proxy_read_timeout 60s;
    }

    # Uploaded product images/videos and the dynamic sitemap also come from the API.
    location /static/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        expires 30d;
    }
    location = /sitemap.xml {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
    }

    # --- Storefront (static build) ------------------------------------------
    # Hashed build files never change: cache hard.
    location /assets/ {
        root /srv/maru/frontend/dist;
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/maru-security-headers.conf;
    }

    location / {
        root /srv/maru/frontend/dist;
        try_files $uri /index.html;      # single-page app routing
        include /etc/nginx/snippets/maru-security-headers.conf;
    }
}

# Copy deploy/nginx-security-headers.conf to /etc/nginx/snippets/maru-security-headers.conf
